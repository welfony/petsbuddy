        <a class="subnavbar__thumbnail grid__col-sm-3" href="product-10.html">
          <img class="subnavbar__thumbnail-img" src="img/nav/Freeze-Dried-Meat.png" />
          <h3 class="subnavbar__thumbnail-header">Roo Meat Cube</h3>
        </a>
        <a class="subnavbar__thumbnail grid__col-sm-3" href="product-13.html">
          <img class="subnavbar__thumbnail-img" src="img/nav/ChickenBreast.png" />
          <h3 class="subnavbar__thumbnail-header">Chicken Breast</h3>
        </a>
        <a class="subnavbar__thumbnail grid__col-sm-3" href="product-21.html">
          <img class="subnavbar__thumbnail-img" src="img/nav/Lamb Liver.png" />
