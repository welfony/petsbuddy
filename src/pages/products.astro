---
import Template from '../layouts/default.astro';
---

<Template title={"Products - PetsBuddy"}>
  <div class="banner banner--no-fixed-height">
    <div class="banner__container grid grid--justify-center grid--align-end">
      <div class="banner__logo-wrapper">
        <img class="banner__logo" src="img/products.png" alt="All Products" />
      </div>
      <div class="banner__title-wrapper">
        <h2
          class="banner__header header header--is-color-white header--is-normal-size-2 font-weight-extra-light color_header"
        >
          KEEP FRESH AND HEALTHY IN EVERY BITE
        </h2>
      </div>
    </div>
  </div>

  <div class="container container--has-padding-mobile container_class">
    <div
      class="section section--has-medium-padding-top section--has-big-padding-bottom section--has-smaller-padding-bottom-mobile"
    >
      <div class="title-content">
        <a name="list"></a>
        <h3
          class="header font-weight-extra-light header--is-smaller-mobile text-left-md-up title-content__title"
        >
          Our products
        </h3>

        <div id="petnowdropshipping_store" title="0e526d1e0c2510530d0aa4896c15bd5d" style="width: 100%;border: none;"></div>
        <script is:inline src="https://dropshipping.petnow.com.au/assets/js/shopping_page.js" ></script>
      </div>
    </div>
  </div>
</Template>