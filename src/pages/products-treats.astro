                    srcset="
                      img/product_list/ChickenBreast.png,
                      img/product_list/ChickenBreast.png 2x
                    "
                    type="image/png"
                  />

                  <img
                    class="card__img js-product-img"
                    src="img/product_list/ChickenBreast.png"
