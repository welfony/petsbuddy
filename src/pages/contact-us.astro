---
import Banner from "../components/banner.astro";
import Template from "../layouts/default.astro";
---

<Template title={"Contact Us - PetsBuddy"}>
  <Banner />
  <div
    class="section section--has-medium-padding section--has-smaller-padding-top-below-desktop contact"
  >
    <div class="container container--has-padding-mobile">
      <div
        class="grid reverse-children-order reverse-children-order--on-tablet"
      >
        <div class="filters-list grid__col-sm-12 grid__col-md-4">
          <h4
            class="filters-list__header filters-list__header--has-small-mg-b header header--is-smallest-size font-weight-bold text-uppercase text-left"
          >
            CONTACT US
          </h4>
          <div class="filters-list__section-container">
            <div
              class="filters-list__section filters-list__section--is-inline-sm filters-list__section--has-sm-padding"
            >
              <div class="icon-text grid" style="margin-top: 5px">
                <div class="icon-text__icon icon-text__icon--is-bigger">
                  <img
                    src="img/icon-address.png"
                    alt="Address icon"
                    style="margin-top: 8px"
                  />
                </div>
                <div class="icon-text__text grid__col-auto">
                  <p>Email:</p>
                  <p>customerservice@australiapetindustry.com</p>
                </div>
              </div>
            </div>
            <div
              class="filters-list__section filters-list__section--is-inline-sm filters-list__section--has-sm-padding"
            >
              <div class="icon-text grid">
                <div class="icon-text__icon icon-text__icon--is-bigger">
                  <img
                    src="img/icon-phone.png"
                    alt="Phone icon"
                    style="margin-top: 8px"
                  />
                </div>
                <div class="icon-text__text grid__col-auto">
                  <p>Phone:</p>
                  <p>+61 0433 930 701</p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div
          class="contact__description cms-content-description nudged-content nudged-content--is-nudged-higher-half nudged-content--is-md-up grid__col-sm-12 grid__col-md-8"
        >
          <div class="cms-content">
            <div
              class="cms-content__title cms-content__title--has-small-margin"
            >
              <h2>PetsBuddy - Customer Service</h2>
            </div>
            <p>
              We would love to hear from you. If you have any questions, email
              us or fill out the form below and we'll be in touch!
            </p>
          </div>
          <form
            class="contact__form form form--has-negative-margin form--has-negative-margin"
            action="https://formspree.io/f/mdawekbb"
            method="post"
            id="contact_form"
          >
            <div class="grid">
              <div
                class="form__input-container-wrapper grid__col-xs-12 grid__col-sm-6"
              >
                <div
                  class="form__input-container form__input-container--has-resizing-placeholder text-uppercase-on-label js-form-field"
                >
                  <label for="id_first_name">First name</label>
                  <input
                    class="form__input form__input--has-dark-text"
                    id="id_first_name"
                    name="first_name"
                    type="text"
                  />
                </div>
              </div>
              <div
                class="form__input-container-wrapper grid__col-xs-12 grid__col-sm-6"
              >
                <div
                  class="form__input-container form__input-container--has-resizing-placeholder text-uppercase-on-label js-form-field"
                >
                  <label for="id_last_name">Last name</label>
                  <input
                    class="form__input form__input--has-dark-text"
                    id="id_last_name"
                    name="last_name"
                    type="text"
                  />
                </div>
              </div>
              <div
                class="form__input-container-wrapper grid__col-xs-12 grid__col-sm-6"
              >
                <div
                  class="form__input-container form__input-container--has-resizing-placeholder text-uppercase-on-label js-form-field"
                >
                  <label for="id_email">Email</label>
                  <input
                    class="form__input form__input--has-dark-text"
                    id="id_email"
                    name="email"
                    type="email"
                  />
                </div>
              </div>
              <div
                class="form__input-container-wrapper grid__col-xs-12 grid__col-sm-6"
              >
                <div
                  class="form__input-container form__input-container--has-resizing-placeholder text-uppercase-on-label js-form-field"
                >
                  <label for="id_phone">Phone</label>
                  <input
                    class="form__input form__input--has-dark-text"
                    id="id_phone"
                    name="phone"
                    type="text"
                  />
                </div>
              </div>
              <div
                class="form__input-container-wrapper grid__col-xs-12 grid__col-sm-6"
              >
                <div
                  class="form__input-container form__input-container--has-resizing-placeholder text-uppercase-on-label js-form-field"
                >
                  <label for="id_city">City</label>
                  <input
                    class="form__input form__input--has-dark-text"
                    id="id_city"
                    name="city"
                    type="text"
                  />
                </div>
              </div>
              <div
                class="form__input-container-wrapper grid__col-xs-12 grid__col-sm-6"
              >
                <div
                  class="form__input-container form__input-container--has-resizing-placeholder text-uppercase-on-label js-form-field"
                >
                  <label for="id_country">Country</label>
                  <input
                    class="form__input form__input--has-dark-text"
                    id="id_country"
                    name="country"
                    type="text"
                  />
                </div>
              </div>
              <div class="form__input-container-wrapper grid__col-xs-12">
                <div class="form__input-container">
                  <textarea
                    class="form__input form__input--has-smaller-padding form__input--has-dark-text"
                    cols="40"
                    id="id_message"
                    name="message"
                    placeholder="MESSAGE"
                    rows="10"></textarea>
                </div>
              </div>
              <div class="form__input-container-wrapper grid__col-xs-12">
                <div class="form__input-container">
                  <button type="submit" class="btn btn-default">Send</button>
                </div>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const form = document.getElementById("contact_form");

      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        const formData = new FormData(form);
        const formProps = Object.fromEntries(formData);

        // Simple validation to check for empty fields
        const hasEmptyFields = Object.values(formProps).some(
          (value) => !value.trim(),
        );

        if (hasEmptyFields) {
          alert("Please fill out all fields.");
          return;
        }

        try {
          const response = await fetch("https://formspree.io/f/mdawekbb", {
            method: "POST",
            body: JSON.stringify(formProps),
            headers: {
              Accept: "application/json",
              "Content-Type": "application/json",
            },
          });

          if (response.ok) {
            alert("Thanks for your review!");
            form.reset();
          } else {
            const data = await response.json();
            console.error("Form submission failed:", data);
            alert("Oops! There was a problem submitting your form.");
          }
        } catch (error) {
          console.error("Network error:", error);
          alert("Network error. Please check your connection and try again.");
        }
      });
    });
  </script>
</Template>
